type Vec2(x: Float, y: Float)

impl Vec2 {
    def ID: Vec2 = Vec2(1.0, 1.0)

    def dot(self, rhs: Vec2): Float = self.x * rhs.x + self.y * rhs.y
    def double(mut self): () = {
        self.x = self.x * 2
        self.y = self.y * 2
    }
}

def main(): () = {
    let a = Vec2(1.0, 1.0)
    let mut b = a
    b.double()
    Vec2::double(mut b)
    print a.dot(b).dot(Vec2::ID)
}