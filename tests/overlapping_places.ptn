type Box(v: Int)
def field(): () = {
    let f = fn(mut a, b: Box) -> { a = a + b.v }
    let g = fn(mut a) -> f(mut a.v, a)
}

def same_swap(): () = {
    let mut a = 1
    swap(mut a, mut a)
}
def swap(mut a: Int, mut b: Int): () = {}

def array_same_swap(): () = {
    let mut foo = [1, 1]
    swap(mut foo.[0], mut foo.[0])
}
def swap(mut a: Int, mut b: Int): () = {}
