def closures(): () = {
    let f = fn(mut a, b) -> a = a + b
    let b = 5
    let g = fn(mut a) -> f(mut a, b)
}

type Point(x: Int, y: Int)

def fields_disjoint_swap(): () = {
    let mut foo = Point(1, 2)
    swap(mut foo.x, mut foo.y)
}

def swap(mut a: Int, mut b: Int): () = {
    let a_tmp = a
    a = b
    b = a_tmp
}