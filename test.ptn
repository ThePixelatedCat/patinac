record Point(x: Float, y: Float)

fn main() -> {
    let mut point = Point(1.0, 0.0)
    point.y = 5.0
    swap(mut point)
    inc(mut point.y)
    print point.x
    print point.y
}

fn inc(mut n: Float) -> n = n +. 1.0

fn swap(mut self: Point) -> {
    let x = self.x
    self.x = self.y
    self.y = x
}